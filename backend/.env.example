# ---- ScholarScope AI backend configuration (copy to .env; never commit real secrets) ----
APP_ENV=development
# 32+ random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Default: sqlite file in backend/. PostgreSQL example: postgresql+psycopg://user:pass@localhost/scholarscope
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TOKEN_TTL_MINUTES=720

# Crawler
CRAWLER_USER_AGENT=ScholarScopeBot/1.0 (academic project; scholarship freshness monitor)
CRAWLER_TIMEOUT_SECONDS=25
CRAWLER_MAX_BYTES=15728640
CRAWLER_MAX_RETRIES=3
CRAWLER_MIN_DOMAIN_INTERVAL_SECONDS=3
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60

# LLM extraction (optional). Without a key, extraction fails clearly and admins enter data manually.
LLM_PROVIDER=gemini            # gemini | anthropic
LLM_API_KEY=
LLM_MODEL=                     # empty = provider default (see app/services/extraction/llm.py)
LLM_MAX_INPUT_CHARS=60000

MAX_UPLOAD_BYTES=10485760
DEMO_MODE=false
# Used only by `python -m app.cli create-admin` to avoid an interactive prompt
ADMIN_PASSWORD=
